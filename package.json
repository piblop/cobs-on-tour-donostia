{
  "name": "cobs-on-tour-donostia",
  "private": true,
  "version": "0.1.0",
  "description": "Cobs on Tour: Donostia, a cosy browser exploration game about four friends in San Sebastián.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate": "node scripts/validate-data.ts",
    "factcheck": "node scripts/factcheck.ts",
    "check": "npm run typecheck && npm run validate && npm test"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
